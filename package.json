{
  "name": "caspita",
  "version": "1.0.0",
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "build:client": "cd caspita-client && npm run build",
    "client:watch": "cd caspita-client && npm run watch",
    "demo": "ts-node src/demo.ts",
    "demo:reset": "ts-node src/demo.ts --reset",
    "dist:win": "npm run build && npm run build:client && node scripts/build-win.js",
    "icon": "node desktop/icon/make-icon.js"
  },
  "dependencies": {
    "@puppeteer/browsers": "^2.13.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "israeli-bank-scrapers": "^6.13.0",
    "moment": "^2.31.0",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^24.42.0",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "description": "Caspita — לוח בקרה לכספים האישיים",
  "author": "Caspita",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "puppeteer@24.42.0": true,
    "sqlite3@6.0.1": true
  }
}
